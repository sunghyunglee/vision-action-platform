# cp .env.example .env 후 값을 바꿔서 사용. .env는 Git에 올리지 않는다.

# ── FastAPI AI 서버 ──
MODEL_DIR=/app/models
RF_MODEL_FILE=rf_action_baseline.joblib
RF_COLUMNS_FILE=rf_feature_columns.json
RF_INFO_FILE=rf_training_info.json
POSE_WEIGHTS=yolo11n-pose.pt
POSE_CONF=0.5
POSE_DEVICE=cpu

# ── Django ──
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── PostgreSQL (Compose 서비스 이름 postgres) ──
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis · Celery (Compose 서비스 이름 redis) ──
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=600

# ── FastAPI AI 서버 주소 (Compose 서비스 이름 fastapi) ──
AI_SERVICE_URL=http://fastapi:8001
AI_SERVICE_TIMEOUT=300
MAX_UPLOAD_MB=100
LOW_CONFIDENCE_THRESHOLD=0.5

# ── IP Webcam: 허용한 카메라 주소만, 쉼표로 여러 개 ──
IP_WEBCAM_ALLOWED_URLS=http://PHONE_IP:8080/video
CAMERA_CAPTURE_SECONDS=8
CAMERA_CONNECT_TIMEOUT=10
